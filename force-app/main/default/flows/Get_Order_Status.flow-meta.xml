    <description>Looks up an Alpha Bravo Energy customer order by order number and returns status, account name, and item count.</description>
    <interviewLabel>Get Order Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Order Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
