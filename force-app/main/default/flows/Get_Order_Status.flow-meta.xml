            </value>
        </filters>
        <object>OrderItem</object>
        <outputReference>orderItemsCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>Product2Id</queriedFields>
    </recordLookups>
    <start>
